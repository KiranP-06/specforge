# Copy to .env for docker compose. Never commit the real .env.
POSTGRES_PASSWORD=change-me
JWT_SECRET=generate-with-openssl-rand-hex-32
# heuristic (offline, default) | openai (any OpenAI-compatible API: OpenAI, Groq, OpenRouter, Ollama, Gemini) | anthropic
LLM_PROVIDER=heuristic
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# true = sentence-transformers + NLI cross-encoder (CPU). Build the image with WITH_ML=true.
USE_TRANSFORMER_MODELS=false
WITH_ML=false
