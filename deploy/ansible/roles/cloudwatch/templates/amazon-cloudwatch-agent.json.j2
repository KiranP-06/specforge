{
  "agent": { "metrics_collection_interval": 60, "run_as_user": "root" },
  "metrics": {
    "namespace": "CWAgent",
    "append_dimensions": { "InstanceId": "${aws:InstanceId}" },
    "metrics_collected": {
      "mem": { "measurement": ["mem_used_percent"] },
      "disk": { "measurement": ["used_percent"], "resources": ["/"], "drop_device": true },
      "swap": { "measurement": ["swap_used_percent"] }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          { "file_path": "/var/log/containers/api-*_{{ app_namespace }}_api-*.log",       "log_group_name": "/{{ project }}/api",    "log_stream_name": "{instance_id}-api" },
          { "file_path": "/var/log/containers/worker-*_{{ app_namespace }}_worker-*.log", "log_group_name": "/{{ project }}/worker", "log_stream_name": "{instance_id}-worker" },
          { "file_path": "/var/log/containers/web-*_{{ app_namespace }}_web-*.log",       "log_group_name": "/{{ project }}/web",    "log_stream_name": "{instance_id}-web" },
          { "file_path": "/var/log/syslog", "log_group_name": "/{{ project }}/system", "log_stream_name": "{instance_id}-syslog" }
        ]
      }
    }
  }
}
